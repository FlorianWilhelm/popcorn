{
  "manifest_version": 3,
  "name": "Meet Update Rotator",
  "version": "0.12",
  "description": "Zeigt in Google Meet die 5 anwesenden Personen, deren letztes Projektupdate am laengsten zurueckliegt.",
  "permissions": ["storage", "scripting", "activeTab", "tabs"],
  "host_permissions": ["https://meet.google.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Update Rotator"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
