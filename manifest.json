{
  "manifest_version": 3,
  "name": "POPCORN – Google Meet Standup & Speaker Picker",
  "version": "0.25",
  "description": "Fair speaker order & standup picker for Google Meet. Rotates attendees popcorn-style for smooth daily updates and notes.",
  "permissions": ["storage", "scripting", "activeTab", "tabs"],
  "host_permissions": ["https://meet.google.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "POPCORN",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
